{
  "name": "au-rental-application-kit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2 --no-file-parallelism",
    "build": "pnpm --filter @aurak/renter build && pnpm --filter @aurak/agent-ui build && pnpm --filter @aurak/inbox-worker build",
    "gen": "tsx scripts/gen.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "dev:inbox": "pnpm --filter @aurak/inbox-worker dev",
    "dev:renter": "pnpm --filter @aurak/renter dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.10.3",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "tsx": "^4",
    "typescript": "~5.9.3",
    "unpdf": "^2.1.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0",
    "zod": "^4.6.7"
  },
  "type": "module"
}
