{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aurak-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent", "/agent/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurak",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "aurak-docs"
    },
    {
      "binding": "KEYS",
      "bucket_name": "aurak-keys"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "access",
    "ACTIVE_KEK_ID": "v1",
    "RENTER_APP_ORIGINS": "",
    "NSW_PPI_COMMENCEMENT_DATE": "",
    "TURNSTILE_SITE_KEY": ""
  },
  "secrets": {
    "required": ["DATA_KEK_V1", "ACCESS_TEAM_DOMAIN", "ACCESS_AUD", "BOOTSTRAP_ADMIN_EMAIL"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "AUTH_MODE": "dev-insecure",
        "ACTIVE_KEK_ID": "v1",
        "RENTER_APP_ORIGINS": "",
        "NSW_PPI_COMMENCEMENT_DATE": "",
        "TURNSTILE_SITE_KEY": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aurak-dev",
          "database_id": "REPLACE_WITH_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCS",
          "bucket_name": "aurak-docs-dev"
        },
        {
          "binding": "KEYS",
          "bucket_name": "aurak-keys-dev"
        }
      ],
      "secrets": {
        "required": ["DATA_KEK_V1"]
      }
    }
  }
}
